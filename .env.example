# Copy to .env and adjust. Environment-specific overrides go in .env.qa, .env.uat, .env.prod
TEST_ENV=qa
BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://jsonplaceholder.typicode.com
APP_USERNAME=tomsmith
APP_PASSWORD=SuperSecretPassword!

HEADLESS=true
SLOW_MO=0
RETRIES=0
WORKERS=2

TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000

TEST_ID_ATTRIBUTE=data-testid
LOG_LEVEL=info

# Bundled QA Demo App (tests/demo)
DEMO_PORT=4000
DEMO_USERNAME=admin
DEMO_PASSWORD=Admin@123
# Video recording: off | on | retain-on-failure | on-first-retry
VIDEO=retain-on-failure
# Optional path to an installed Chrome/Chromium
# CHROME_PATH=/usr/bin/google-chrome
